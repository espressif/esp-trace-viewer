{
  "name": "esp-trace-viewer",
  "version": "0.1.0",
  "private": true,
  "description": "Web-based viewer for .svdat trace files.",
  "type": "module",
  "scripts": {
    "test": "npm run test:unit",
    "test:unit": "tsx --test --test-concurrency=1 test/unit/*.test.ts",
    "typecheck": "tsc --noEmit",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:e2e:docker": "scripts/e2e-docker.sh",
    "test:e2e:docker:update": "scripts/e2e-docker.sh --update-snapshots"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=22"
  }
}
